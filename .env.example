# Omitting credentials uses the current operating-system user via PostgreSQL peer authentication.
APP_ENV=development
DATABASE_URL=postgres:///ledgerops?host=/var/run/postgresql
# Production only: use a separate DDL-capable role for migrations.
MIGRATION_DATABASE_URL=
PORT=8080
ALLOWED_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SEED_DEMO=true
WORKER_POLL_INTERVAL=2s
REMINDER_POLL_INTERVAL=1m
QUICKBOOKS_SCHEDULE_POLL_INTERVAL=1m
QUICKBOOKS_OUTBOX_POLL_INTERVAL=2s
EMAIL_DELIVERY_POLL_INTERVAL=5s
AUTH_SESSION_TTL=12h
# Keep false for local HTTP. Production HTTPS must set this to true.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_IDLE_TTL=30m
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW=1m
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW=5m
SENSITIVE_RATE_LIMIT_REQUESTS=30
SENSITIVE_RATE_LIMIT_WINDOW=1m
TRUSTED_PROXY_CIDRS=

# QuickBooks Online sandbox OAuth. Create Development credentials in the Intuit Developer Portal.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URL=http://localhost:8080/api/v1/integrations/quickbooks/callback
QUICKBOOKS_API_BASE_URL=https://sandbox-quickbooks.api.intuit.com
# Generate once with: openssl rand -base64 32
QUICKBOOKS_TOKEN_ENCRYPTION_KEY=
# Production: use AWS KMS instead of QUICKBOOKS_TOKEN_ENCRYPTION_KEY.
QUICKBOOKS_KMS_KEY_ID=
QUICKBOOKS_KMS_REGION=
# Webhook verifier token from the Intuit Developer Portal.
QUICKBOOKS_WEBHOOK_VERIFIER=

# SMTP delivers collection reminders and password reset links. It is required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=LedgerOps
# Shared with the trusted relay that POSTs normalized delivery events.
EMAIL_WEBHOOK_SECRET=

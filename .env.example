# Omitting credentials uses the current operating-system user via PostgreSQL peer authentication.
DATABASE_URL=postgres:///ledgerops?host=/var/run/postgresql
PORT=8080
ALLOWED_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SEED_DEMO=true
WORKER_POLL_INTERVAL=2s
REMINDER_POLL_INTERVAL=1m
EMAIL_DELIVERY_POLL_INTERVAL=5s
AUTH_SESSION_TTL=12h
# Keep false for local HTTP. Production HTTPS must set this to true.
AUTH_COOKIE_SECURE=false

# QuickBooks Online sandbox OAuth. Create Development credentials in the Intuit Developer Portal.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URL=http://localhost:8080/api/v1/integrations/quickbooks/callback
QUICKBOOKS_API_BASE_URL=https://sandbox-quickbooks.api.intuit.com
# Generate once with: openssl rand -base64 32
QUICKBOOKS_TOKEN_ENCRYPTION_KEY=

# Optional SMTP delivery. Leave SMTP_HOST empty to keep reminders safely queued.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=LedgerOps
# Shared with the trusted relay that POSTs normalized delivery events.
EMAIL_WEBHOOK_SECRET=
